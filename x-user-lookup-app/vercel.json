{
  "version": 2,
  "functions": {
    "api/lookup.py": {
      "maxDuration": 60,
      "includeFiles": "{xlookup/**,core.py,public/sample.json}"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ]
}
