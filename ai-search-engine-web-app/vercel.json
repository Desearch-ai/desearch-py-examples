{
  "version": 2,
  "functions": {
    "api/search.py": { "maxDuration": 30, "includeFiles": "searchapp/**" },
    "api/answer.py": { "maxDuration": 60, "includeFiles": "searchapp/**" }
  },
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "no-referrer" }
    ] }
  ]
}
